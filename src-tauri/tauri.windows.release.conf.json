{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "TCloud",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "dragDropEnabled": true,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/vc_redist.x64.exe"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "./windows/vcredist-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "TCloud"
      }
    }
  }
}
